--!strict
-- Ennemis (docs/dossier/13-ennemis-boss.md section 3, roster v2 ; dossier 20 section 4).
-- Les ids restent dans 1..31 (5 bits sur le réseau, EnemyCodec).
-- Nombres = monde 1, solo ; EnemyService applique l'échelle du monde, de l'Overtime et de la coop.
--
-- Visuel (étape 4, dossier 13 §6 et §9.1) : `asset` = nom du modèle posé par Clément dans
-- ReplicatedStorage.Assets.Creatures (ArtLibrary.find ; sans `asset` : "Enemy_<name>"). Rien n'est
-- fabriqué par script : un modèle absent est signalé une fois dans la sortie et EnemyRenderer clone à
-- sa place Assets.Creatures.Enemy_Placeholder s'il existe (sinon l'ennemi n'est pas dessiné).
-- `height` et `radius` = gabarit de gameplay (contact, tirs, marqueurs si le modèle n'a pas ses
-- attributs). Le dessin vient du modèle, posé à sa taille finale (attributs Height, Radius, Float).
-- `color` ne sert plus qu'à teinter l'imposteur lointain (Assets.FX.Enemies.Impostor).
--
-- Comportements (A03-04, tout en données côté serveur dans EnemyService) :
--   Support  : garde ses distances et lance une aura toutes les `auraEvery` s (soin, hâte des
--              voisins, ralenti des joueurs, rassemblement).
--   Kamikaze : fonce, allume sa mèche à `fuseRange`, explose (`blast*`), vole de l'XP (`xpSteal`).
--   burrow   : apparaît sous terre (ni visible, ni touchable), surgit près du joueur (`emerge*`).
--   puddle*  : laisse une nappe au sol à sa mort (ralentit et blesse les joueurs dedans).

local Types = require(script.Parent.Parent.Types)

export type Family = "Swarm" | "Jumper" | "Shooter" | "Armored" | "Support" | "Kamikaze" | "MiniBoss" | "Boss"

export type Def = {
	id: number,
	name: string,
	label: Types.LocalizedText,
	world: string,
	family: Family,
	hp: number,
	speed: number,
	radius: number,
	height: number,
	color: Color3,
	contactDamage: number,
	xp: number,
	asset: string?, -- gabarit visuel (voir l'en-tête)
	legacyAsset: string?, -- ancien modèle de la place, utilisé tant que `asset` manque
	armor: number?, -- damage reduction 0..1 (Armored)
	weight: number?, -- separation weight (Armored push others)
	knockbackMult: number?,
	-- Jumper
	leapRange: number?,
	leapWindup: number?,
	leapAir: number?,
	leapCooldown: number?,
	-- Shooter (Support et Kamikaze lisent aussi keepDistance)
	keepDistance: number?,
	shotRange: number?,
	shotWindup: number?,
	shotCooldown: number?,
	shotSpeed: number?,
	shotDamage: number?,
	shotRadius: number?,
	shotCount: number?, -- projectiles par tir (éventail), 1 par défaut
	shotSpread: number?, -- ouverture de l'éventail, degrés
	-- Support : une aura toutes les auraEvery s, annoncée auraWindup s avant
	auraEvery: number?,
	auraWindup: number?,
	auraRadius: number?,
	auraHeal: number?, -- part des PV max rendue aux voisins (et à lui-même)
	auraHaste: number?, -- multiplicateur de vitesse des voisins
	auraHasteTime: number?,
	auraSlow: number?, -- multiplicateur de vitesse des joueurs dans la zone (RunManager.setSlow)
	auraSlowTime: number?,
	auraRally: boolean?, -- les voisins prennent sa cible
	-- Kamikaze
	fuseRange: number?,
	fuseTime: number?,
	blastRadius: number?,
	blastDamage: number?,
	xpSteal: number?, -- XP prise à chaque joueur touché (StatsService.takeXp, si exposé)
	xpStealDrop: number?, -- part de l'XP volée qui retombe au sol, à ramasser
	-- Surgit du sol
	burrow: boolean?,
	burrowSpeed: number?, -- multiplicateur de vitesse sous terre
	emergeRange: number?,
	emergeWindup: number?,
	emergeRadius: number?,
	emergeDamage: number?,
	-- Nappe laissée à la mort
	puddleRadius: number?,
	puddleTime: number?,
	puddleDps: number?,
	puddleSlow: number?,
	-- Variante capturable (A03-03) : remplace Run.Capturable.Chance pour cette espèce (0 = jamais)
	captureChance: number?,
	-- Mini-boss
	coinsPerHit: boolean?,
	isBoss: boolean?,
	-- Tir : objet cloné par EnemyRenderer, Assets.FX.Enemies.Projectiles.<projectile> (sinon Default)
	projectile: string?,
	-- Mini-boss (contract request 5, dossier 13 §9.3) : une attaque de zone annoncée toutes les
	-- slamEvery s, quand un joueur est à moins de slamRange. slamShape : "Front" = cercle devant lui,
	-- "Self" = cercle centré sur lui, "Ring" = anneau de slamInner à slamRadius (se saute).
	-- Annonce : EnemyAttackVisual "aim" (rayon), puis "boss" à l'impact ; état action pendant la préparation.
	slamName: string?,
	slamShape: ("Front" | "Self" | "Ring")?,
	slamEvery: number?,
	slamWindup: number?,
	slamRadius: number?,
	slamInner: number?,
	slamDamage: number?,
	slamRange: number?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

