--!strict
-- Ennemis (docs/dossier/13-ennemis-boss.md section 3, roster v2 ; dossier 20 section 4).
-- Les ids restent dans 1..31 (5 bits sur le réseau, EnemyCodec).
-- Nombres = monde 1, solo ; EnemyService applique l'échelle du monde, de l'Overtime et de la coop.
--
-- Visuel (A03-01) : `asset` = nom du gabarit posé par Clément (A01), cherché par EnemyRenderer dans
-- ReplicatedStorage.Assets (récursif, en pratique Assets.Creatures), puis dans
-- ReplicatedStorage.EnemyVisualRigs. Sans `asset`, le nom cherché est "Enemy_<name>".
-- Gabarit absent : repli sur `model` (Parts v1, seulement pour les entrées v1 gardées) ou sur un bloc
-- de la couleur `color`, et un avertissement unique dans la sortie.
-- `height` = hauteur de gameplay = hauteur dessinée ÷ 1,3 (EnemyRenderer dessine à ×1,3).
--
-- Comportements (A03-04, tout en données côté serveur dans EnemyService) :
--   Support  : garde ses distances et lance une aura toutes les `auraEvery` s (soin, hâte des
--              voisins, ralenti des joueurs, rassemblement).
--   Kamikaze : fonce, allume sa mèche à `fuseRange`, explose (`blast*`), vole de l'XP (`xpSteal`).
--   burrow   : apparaît sous terre (ni visible, ni touchable), surgit près du joueur (`emerge*`).
--   puddle*  : laisse une nappe au sol à sa mort (ralentit et blesse les joueurs dedans).

local Types = require(script.Parent.Parent.Types)

export type Family = "Swarm" | "Jumper" | "Shooter" | "Armored" | "Support" | "Kamikaze" | "MiniBoss" | "Boss"

export type ModelPart = {
	shape: "Ball" | "Block" | "Cylinder" | "Wedge",
	size: Vector3,
	offset: Vector3,
	color: Color3,
	rot: Vector3?, -- degrees
	neon: boolean?,
}

export type Def = {
	id: number,
	name: string,
	label: Types.LocalizedText,
	world: string,
	family: Family,
	hp: number,
	speed: number,
	radius: number,
	height: number,
	color: Color3,
	contactDamage: number,
	xp: number,
	asset: string?, -- gabarit visuel (voir l'en-tête)
	armor: number?, -- damage reduction 0..1 (Armored)
	weight: number?, -- separation weight (Armored push others)
	knockbackMult: number?,
	-- Jumper
	leapRange: number?,
	leapWindup: number?,
	leapAir: number?,
	leapCooldown: number?,
	-- Shooter (Support et Kamikaze lisent aussi keepDistance)
	keepDistance: number?,
	shotRange: number?,
	shotWindup: number?,
	shotCooldown: number?,
	shotSpeed: number?,
	shotDamage: number?,
	shotRadius: number?,
	shotCount: number?, -- projectiles par tir (éventail), 1 par défaut
	shotSpread: number?, -- ouverture de l'éventail, degrés
	-- Support : une aura toutes les auraEvery s, annoncée auraWindup s avant
	auraEvery: number?,
	auraWindup: number?,
	auraRadius: number?,
	auraHeal: number?, -- part des PV max rendue aux voisins (et à lui-même)
	auraHaste: number?, -- multiplicateur de vitesse des voisins
	auraHasteTime: number?,
	auraSlow: number?, -- multiplicateur de vitesse des joueurs dans la zone (RunManager.setSlow)
	auraSlowTime: number?,
	auraRally: boolean?, -- les voisins prennent sa cible
	-- Kamikaze
	fuseRange: number?,
	fuseTime: number?,
	blastRadius: number?,
	blastDamage: number?,
	xpSteal: number?, -- XP prise à chaque joueur touché (StatsService.takeXp, si exposé)
	xpStealDrop: number?, -- part de l'XP volée qui retombe au sol, à ramasser
	-- Surgit du sol
	burrow: boolean?,
	burrowSpeed: number?, -- multiplicateur de vitesse sous terre
	emergeRange: number?,
	emergeWindup: number?,
	emergeRadius: number?,
	emergeDamage: number?,
	-- Nappe laissée à la mort
	puddleRadius: number?,
	puddleTime: number?,
	puddleDps: number?,
	puddleSlow: number?,
	-- Variante capturable (A03-03) : remplace Run.Capturable.Chance pour cette espèce (0 = jamais)
	captureChance: number?,
	-- Mini-boss
	coinsPerHit: boolean?,
	isBoss: boolean?,
	model: { ModelPart }, -- repli v1 en Parts (vide pour le roster v2)
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end
