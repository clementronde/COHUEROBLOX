--!strict
-- Enemy definitions (docs/dossier/20-run-mondes-boss.md section 4).
-- Kind ids must stay in 1..31 (packed into 5 bits on the wire).
-- Numbers are Tier 1, stage 1, solo; RunManager/EnemyService apply tier, stage and coop multipliers.
-- `model` = low-poly parts for the client: shape, size, offset from the feet (studs), color.

local Types = require(script.Parent.Parent.Types)

export type Family = "Swarm" | "Jumper" | "Shooter" | "Armored" | "MiniBoss" | "Boss"

export type ModelPart = {
	shape: "Ball" | "Block" | "Cylinder" | "Wedge",
	size: Vector3,
	offset: Vector3,
	color: Color3,
	rot: Vector3?, -- degrees
	neon: boolean?,
}

export type Def = {
	id: number,
	name: string,
	label: Types.LocalizedText,
	world: string,
	family: Family,
	hp: number,
	speed: number,
	radius: number,
	height: number,
	color: Color3,
	contactDamage: number,
	xp: number,
	armor: number?, -- damage reduction 0..1 (Armored)
	weight: number?, -- separation weight (Armored push others)
	knockbackMult: number?,
	-- Jumper
	leapRange: number?,
	leapWindup: number?,
	leapAir: number?,
	leapCooldown: number?,
	-- Shooter
	keepDistance: number?,
	shotRange: number?,
	shotWindup: number?,
	shotCooldown: number?,
	shotSpeed: number?,
	shotDamage: number?,
	shotRadius: number?,
	-- Mini-boss
	coinsPerHit: boolean?,
	isBoss: boolean?,
	model: { ModelPart },
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end
